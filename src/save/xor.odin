package save

// XOR-обработка на месте. Циклит key по data.
// Одна и та же функция для «шифрования» и «дешифровки».
//
// Это НЕ криптография. Защита от случайного редактирования сохранения,
// не от злоумышленника. Ключ виден в бинарнике.
xor_in_place :: proc(data: []u8, key: []u8) {
    if len(key) == 0 {
        return
    }
    for i in 0 ..< len(data) {
        data[i] = data[i] ~ key[i % len(key)]
    }
}
